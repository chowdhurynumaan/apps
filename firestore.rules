rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========== PRIMARY ADMIN - FULL ACCESS ==========
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == 'MpcB7f35m0bITsSK1D7ACWFmch32';
    }

    // ========== TIMESHEET APP ==========
    // timesheet/app (anchor doc) + all subcollections: config, months, employees, audit, users
    match /timesheet/app {
      allow read, write: if request.auth != null;
    }
    match /timesheet/app/{subcollection}/{document=**} {
      allow read, write: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == 'MpcB7f35m0bITsSK1D7ACWFmch32';
    }

    // ========== ATTENDANCE APP ==========
    // attendance/app (anchor doc) + all subcollections: class_definitions, settings, daily_reports, scores, rosters, users
    match /attendance/app {
      allow read, write: if request.auth != null;
    }
    match /attendance/app/{subcollection}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // ========== QURAN TRACKER ==========
    // quran_tracker/app (anchor doc) + subcollections: students, logs
    match /quran_tracker/app {
      allow read, write: if request.auth != null;
    }
    match /quran_tracker/app/{subcollection}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // ========== ACTION ITEMS ==========
    // action_items/app (anchor doc) + subcollections: ideas, notes
    match /action_items/app {
      allow read, write: if request.auth != null;
    }
    match /action_items/app/{subcollection}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // ========== SHARED ==========
    match /shared/app/{subcollection}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // ========== OLD COLLECTIONS (keep until migration verified) ==========
    match /timesheet_app/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /timesheet_app_months/{monthId} {
      allow read, write: if request.auth != null;
    }
    match /timesheet_app_employees/{employeeId} {
      allow read, write: if request.auth != null;
    }
    match /timesheet_app_audit/{auditId} {
      allow read, write: if request.auth != null;
    }
    match /timesheet_app_users/{userId} {
      allow read, write: if request.auth != null;
    }
    match /artifacts/{appId}/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /studentRosters/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /hifz_classes/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /hifz_students/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /attendance_records/{document=**} {
      allow read, write;
    }
  }
}
